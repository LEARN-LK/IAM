# ============================================================
# Shibboleth IdP v5 - Environment Configuration File
# Edit all values below before running install_idp.sh
# ============================================================

# --- Institution / Domain ---
INSTITUTE_NAME="NAME OF THE UNIVERSITY"
INSTITUTE_DISPLAY_NAME="NAME OF THE UNIVERSITY"
INSTITUTE_URL="https://www.YOUT-DOMAIN.ac.lk"
INSTITUTE_DESCRIPTION="NAME OF THE UNIVERSITY Identity Provider"
INSTITUTE_KEYWORDS="university"

# FQDN of your IdP server (must match DNS)
IDP_FQDN="idp.YOUR-DOMAIN.ac.lk"

# Your domain components (for LDAP base DN)
# e.g. for learn.ac.lk -> DC1=learn DC2=ac DC3=lk
DOMAIN_DC1="YOUR-DOMAIN"
DOMAIN_DC2="ac"
DOMAIN_DC3="lk"

# --- Admin / Contact ---
ADMIN_EMAIL="admin@YOUR-DOMAIN.ac.lk"
SUPPORT_EMAIL="support@YOUR-DOMAIN.ac.lk"
TECHNICAL_EMAIL="technical@YOUR-DOMAIN.ac.lk"

# --- SSL / Certbot ---
# Password used to protect the PKCS12 keystore (Jetty SSL)
SSL_KEYSTORE_PASSWORD="ChangeMeNow123"

# --- MySQL ---
MYSQL_ROOT_PASSWORD="RootPass@2024"
MYSQL_SHIB_USER="shib"
MYSQL_SHIB_PASSWORD="Learn@123"

#do not change the DB name
MYSQL_DB_NAME="storageservice"

# --- LDAP ---
# Choose: starttls | tls | plain
LDAP_MODE="starttls"

LDAP_FQDN="ldap.YOUR-DOMAIN.ac.lk"
LDAP_BIND_DN_PASSWORD="LdapAdmin@2024"

# Organisation type - pick one:
# urn:schac:homeOrganizationType:int:university
# urn:schac:homeOrganizationType:int:library
# urn:schac:homeOrganizationType:int:public-research-institution
# urn:schac:homeOrganizationType:int:private-research-institution
SCHAC_HOME_ORG_TYPE="urn:schac:homeOrganizationType:int:university"

# --- Software Versions ---
JETTY_VER="12.0.16"
IDP_VER="5.2.1"
