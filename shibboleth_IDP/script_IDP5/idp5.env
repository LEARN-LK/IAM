# =============================================================================
# idp5.env.example  -  settings for install-idp5.sh
#
#   cp idp5.env.example idp5.env && chmod 600 idp5.env
#   sudo ./install-idp5.sh -e idp5.env          # prompts only for anything missing
#   sudo ./install-idp5.sh -e idp5.env -y       # fully non-interactive
#
# This file is sourced by bash: wrap values containing $ ! ` " \ or spaces in
# SINGLE quotes, e.g.  LDAP_BIND_PASSWORD='p@ss$word'
# =============================================================================

# --- Identity of the IdP -----------------------------------------------------
IDP_FQDN=idp.inst.ac.lk
IDP_SCOPE=inst.ac.lk                              # default: FQDN minus first label
#IDP_ENTITY_ID=https://idp.inst.ac.lk/idp/shibboleth   # default shown
ORG_NAME='University of Example'                  # optional; login page title/footer

# --- LDAP --------------------------------------------------------------------
LDAP_URL=ldap://ldap.inst.ac.lk:389
LDAP_SECURITY=starttls                            # starttls | ldaps | plain
LDAP_BASE_DN='ou=people,dc=inst,dc=ac,dc=lk'
LDAP_BIND_DN='cn=admin,dc=inst,dc=ac,dc=lk'
LDAP_BIND_PASSWORD='CHANGE-ME'
LDAP_USER_FILTER='(uid={user})'                   # {user} = login name
#LDAP_CERT_FILE=/root/ldap_server.pem             # PEM of the LDAP server cert (starttls/ldaps)
PERSISTENT_ID_SOURCE=uid

# --- MariaDB (persistent-id + consent storage) --------------------------------
DB_NAME=storageservice
DB_USER=idp_admin
#DB_PASSWORD=                                     # blank/unset = generated

# --- Apache TLS --------------------------------------------------------------
TLS_MODE=letsencrypt                              # letsencrypt | selfsigned | existing
LE_EMAIL=admin@inst.ac.lk                         # letsencrypt only (optional)
#TLS_CERT_FILE=/etc/ssl/certs/idp-fullchain.crt   # existing only
#TLS_KEY_FILE=/etc/ssl/private/idp.key            # existing only
#TLS_CHAIN_FILE=                                  # existing only, optional

# --- LEARN / LIAF federation (optional) ----------------------------------------
CONFIGURE_LEARN=no                                # yes | no
#HOME_ORG_TYPE=urn:schac:homeOrganizationType:int:university

# --- Versions / paths (defaults shown; normally leave alone) --------------------
#IDP_VERSION=5.1.6
#IDP_SHA256=                                      # pin the tarball hash (otherwise fetched from shibboleth.net)
#JETTY_VERSION=12.1.5
#MARIADB_JDBC_VERSION=3.5.10
#DBCP2_VERSION=2.13.0
#POOL2_VERSION=2.12.0
#IDP_HOME=/opt/shibboleth-idp
#JETTY_BASE=/opt/jetty
#JETTY_HTTP_PORT=8080
#JETTY_XMX=1500m
